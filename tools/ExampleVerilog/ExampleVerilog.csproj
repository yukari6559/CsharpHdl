<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- dotnet run -p:Example=alu: each example is standalone (alu and alu-top both define Alu),
       so only one directory is compiled at a time. -->
  <PropertyGroup Condition="'$(Example)' != ''">
    <!-- The examples are short snippets for readers: top-level types, no analyzer clean-up.
         This build checks that they compile against the current API. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1050</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(Example)' != ''">
    <Compile Include="../../examples/$(Example)/*.cs" Link="Example/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpHdl.Core/SharpHdl.Core.csproj" />
    <ProjectReference Include="../../src/SharpHdl.Emit/SharpHdl.Emit.csproj" />
  </ItemGroup>

</Project>
